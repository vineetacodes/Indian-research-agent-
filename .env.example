# ==============================================================================
# BHARATOS RESEARCH INTELLIGENCE — PRODUCTION CONFIGURATION (.env.example)
# ==============================================================================
PORT=8080
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. LLM GATEWAYS (Multi-Model Failover Chain)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3

# ------------------------------------------------------------------------------
# 2. SOVEREIGN INDIA DATA APIs
# ------------------------------------------------------------------------------
OGD_INDIA_API_KEY=your_datagov_api_key_here
NDLI_API_KEY=your_ndli_api_key_here
MOSPI_NADA_API_KEY=your_mospi_api_key_here

# ------------------------------------------------------------------------------
# 3. WEB DISCOVERY & SEARCH
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_KEY=your_serpapi_key_here

# ------------------------------------------------------------------------------
# 4. GEOSPATIAL & LOGISTICS (MapmyIndia / Mappls)
# ------------------------------------------------------------------------------
MAPPLS_CLIENT_ID=your_mappls_client_id_here
MAPPLS_CLIENT_SECRET=your_mappls_client_secret_here

# ------------------------------------------------------------------------------
# 5. SCHOLARLY REPOSITORIES (Free Polite Pools)
# ------------------------------------------------------------------------------
OPENALEX_POLITE_EMAIL=tech@bharatos.in
CROSSREF_POLITE_EMAIL=tech@bharatos.in
